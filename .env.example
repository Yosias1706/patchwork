# PostgreSQL connection string. `docker compose up -d database` starts this default locally.
RAG_DATABASE_URL=postgresql://rag:rag@localhost:5432/rag_document_search
RAG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required by compose.production.yaml. Do not use this example value outside
# local development; use a long random secret and keep it in your secret store.
PATCHWORK_POSTGRES_DB=patchwork
PATCHWORK_POSTGRES_USER=patchwork
PATCHWORK_POSTGRES_PASSWORD=replace-with-a-long-random-password
PATCHWORK_PUBLIC_URL=http://localhost:8000

# Patchwork repository ingestion. A token is optional for public repositories,
# but recommended for larger syncs and required for private repositories.
PATCHWORK_GITHUB_API_URL=https://api.github.com
PATCHWORK_GITHUB_GRAPHQL_URL=https://api.github.com/graphql
PATCHWORK_GITHUB_TOKEN=
# Selected repair PRs to index per full-history scan. Patchwork reads closed-PR
# summaries across the repository first, then fetches detailed diffs only for
# the strongest repair candidates. Use 300 for substantial repositories.
PATCHWORK_DEFAULT_PULL_LIMIT=300

# Optional GitHub OAuth App integration. This enables users to link GitHub and
# index repositories that their account can read, including private repositories.
# Register the callback URL below in the OAuth App settings, then set all four
# values. Generate the encryption key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PATCHWORK_GITHUB_OAUTH_CLIENT_ID=
PATCHWORK_GITHUB_OAUTH_CLIENT_SECRET=
PATCHWORK_GITHUB_OAUTH_REDIRECT_URL=http://127.0.0.1:8000/auth/github/callback
PATCHWORK_GITHUB_OAUTH_SCOPES=read:user repo
PATCHWORK_TOKEN_ENCRYPTION_KEY=
PATCHWORK_WEB_URL=http://127.0.0.1:5173

# A database-backed worker claims queued syncs. These defaults are suitable for
# the single API process in compose.production.yaml.
PATCHWORK_SYNC_WORKER_POLL_SECONDS=2
PATCHWORK_SYNC_LEASE_SECONDS=900

# Chunking and retrieval
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_HASHING_DIMENSIONS=768

# Fully local defaults: no network or API key needed.
RAG_EMBEDDING_PROVIDER=hashing
RAG_LLM_PROVIDER=extractive

# Optional OpenAI-compatible endpoint settings.
# RAG_EMBEDDING_PROVIDER=openai_compatible
# RAG_LLM_PROVIDER=openai_compatible
# RAG_OPENAI_BASE_URL=https://api.openai.com/v1
# RAG_OPENAI_API_KEY=
# RAG_EMBEDDING_MODEL=text-embedding-3-small
# RAG_CHAT_MODEL=gpt-4.1-mini
